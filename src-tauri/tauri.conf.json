{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roxys Admin",
  "version": "1.0.0",
  "identifier": "com.roxystravelplan.admin",
  "build": {
    "frontendDist": "../dist-desktop",
    "devUrl": "http://localhost:5174/admin.html",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "Roxys Admin",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
